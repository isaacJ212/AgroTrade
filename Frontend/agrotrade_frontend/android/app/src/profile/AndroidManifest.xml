<manifest xmlns:android="http://android.com"
    package="com.agrotrade.app">

    <!-- Permiso necesario para conectar con los servidores de Google -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="AgroTrade"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"> <!-- Permite tráfico http si usas backend local en el hackathon -->
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboardSize|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Especifica que esta es la pantalla principal que abre el usuario -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- Meta-data requerida por Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
